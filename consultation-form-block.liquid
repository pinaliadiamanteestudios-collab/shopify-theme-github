{% doc %}
  @prompt
    Create a consultation form section for a specific page. The form should include fields for: full name, email address, phone number, a message/inquiry text area, and a submit button. Style it to look professional and elegant, matching a heritage/luxury brand aesthetic. The form should only appear on this page and not affect other pages.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-consultation-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 48px 32px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border: 1px solid {{ block.settings.border_color }};
    box-sizing: border-box;
  }

  .ai-consultation-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
  }

  .ai-consultation-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 10px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .ai-consultation-{{ ai_gen_id }}__title {
    margin: 0 0 12px;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
    font-weight: 500;
  }

  .ai-consultation-{{ ai_gen_id }}__intro {
    margin: 0 0 32px;
    color: {{ block.settings.muted_text_color }};
    line-height: 1.65;
  }

  .ai-consultation-{{ ai_gen_id }}__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .ai-consultation-{{ ai_gen_id }}__field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-consultation-{{ ai_gen_id }}__field--wide {
    grid-column: 1 / -1;
  }

  .ai-consultation-{{ ai_gen_id }}__label {
    color: {{ block.settings.text_color }};
    font-size: 13px;
    font-weight: 600;
  }

  .ai-consultation-{{ ai_gen_id }}__input,
  .ai-consultation-{{ ai_gen_id }}__textarea {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_radius }}px;
    background: {{ block.settings.input_background_color }};
    color: {{ block.settings.text_color }};
    font: inherit;
    box-sizing: border-box;
  }

  .ai-consultation-{{ ai_gen_id }}__input:focus,
  .ai-consultation-{{ ai_gen_id }}__textarea:focus {
    outline: 2px solid {{ block.settings.accent_color }};
    outline-offset: 2px;
  }

  .ai-consultation-{{ ai_gen_id }}__textarea {
    min-height: 150px;
    resize: vertical;
  }

  .ai-consultation-{{ ai_gen_id }}__submit {
    margin-top: 24px;
    padding: 15px 28px;
    border: 1px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .ai-consultation-{{ ai_gen_id }}__submit:hover {
    opacity: 0.88;
  }

  .ai-consultation-{{ ai_gen_id }}__message {
    margin: 0 0 24px;
    color: {{ block.settings.success_color }};
    font-weight: 600;
  }

  .ai-consultation-{{ ai_gen_id }}__errors {
    margin: 0 0 24px;
    color: {{ block.settings.error_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-consultation-{{ ai_gen_id }} {
      padding: 36px 20px;
    }

    .ai-consultation-{{ ai_gen_id }}__fields {
      grid-template-columns: 1fr;
    }

    .ai-consultation-{{ ai_gen_id }}__field--wide {
      grid-column: auto;
    }
  }
{% endstyle %}

{% if request.page.handle == block.settings.target_page_handle %}
  <consultation-form-{{ ai_gen_id }} class="ai-consultation-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="ai-consultation-{{ ai_gen_id }}__inner">
      {% if block.settings.eyebrow != blank %}<p class="ai-consultation-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
      <h2 class="ai-consultation-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>
      {% if block.settings.introduction != blank %}<p class="ai-consultation-{{ ai_gen_id }}__intro">{{ block.settings.introduction | escape }}</p>{% endif %}

      <form method="post" action="/contact" id="ConsultationForm-{{ ai_gen_id }}" class="ai-consultation-form">
        <div class="ai-consultation-{{ ai_gen_id }}__fields">
          <div class="ai-consultation-{{ ai_gen_id }}__field">
            <label class="ai-consultation-{{ ai_gen_id }}__label" for="ConsultationName-{{ ai_gen_id }}">{{ block.settings.name_label | escape }}</label>
            <input class="ai-consultation-{{ ai_gen_id }}__input" id="ConsultationName-{{ ai_gen_id }}" type="text" name="contact[name]" autocomplete="name" required>
          </div>
          <div class="ai-consultation-{{ ai_gen_id }}__field">
            <label class="ai-consultation-{{ ai_gen_id }}__label" for="ConsultationEmail-{{ ai_gen_id }}">{{ block.settings.email_label | escape }}</label>
            <input class="ai-consultation-{{ ai_gen_id }}__input" id="ConsultationEmail-{{ ai_gen_id }}" type="email" name="contact[email]" autocomplete="email" required>
          </div>
          <div class="ai-consultation-{{ ai_gen_id }}__field">
            <label class="ai-consultation-{{ ai_gen_id }}__label" for="ConsultationPhone-{{ ai_gen_id }}">{{ block.settings.phone_label | escape }}</label>
            <input class="ai-consultation-{{ ai_gen_id }}__input" id="ConsultationPhone-{{ ai_gen_id }}" type="tel" name="contact[phone]" autocomplete="tel">
          </div>
          <div class="ai-consultation-{{ ai_gen_id }}__field ai-consultation-{{ ai_gen_id }}__field--wide">
            <label class="ai-consultation-{{ ai_gen_id }}__label" for="ConsultationMessage-{{ ai_gen_id }}">{{ block.settings.message_label | escape }}</label>
            <textarea class="ai-consultation-{{ ai_gen_id }}__textarea" id="ConsultationMessage-{{ ai_gen_id }}" name="contact[body]" required></textarea>
          </div>
        </div>
        <button class="ai-consultation-{{ ai_gen_id }}__submit" type="submit">{{ block.settings.submit_label | escape }}</button>
      </form>
    </div>
  </consultation-form-{{ ai_gen_id }}>
{% endif %}

{% schema %}
{
  "name": "Consultation form",
  "tag": null,
  "class": "consultation-form-block",
  "settings": [
    {"type":"header","content":"Page targeting"},
    {"type":"text","id":"target_page_handle","label":"Page handle","default":"heritage-redesign"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"header","content":"Content"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Private consultation"},
    {"type":"text","id":"heading","label":"Heading","default":"Begin a conversation"},
    {"type":"textarea","id":"introduction","label":"Introduction","default":"Tell us about your vision and our team will be in touch to arrange a personal consultation."},
    {"type":"text","id":"name_label","label":"Name label","default":"Full name"},
    {"type":"text","id":"email_label","label":"Email label","default":"Email address"},
    {"type":"text","id":"phone_label","label":"Phone label","default":"Phone number"},
    {"type":"text","id":"message_label","label":"Message label","default":"Your inquiry"},
    {"type":"text","id":"submit_label","label":"Submit label","default":"Request consultation"},
    {"type":"textarea","id":"success_message","label":"Success message","default":"Thank you. Your inquiry has been received."},
    {"type":"header","content":"Style"},
    {"type":"color","id":"background_color","label":"Background","default":"#fffffc"},
    {"type":"color","id":"text_color","label":"Text","default":"#000000"},
    {"type":"color","id":"muted_text_color","label":"Muted text","default":"#4a4a4a"},
    {"type":"color","id":"accent_color","label":"Accent","default":"#6f4b3e"},
    {"type":"color","id":"border_color","label":"Border","default":"#d8c8ba"},
    {"type":"color","id":"input_background_color","label":"Input background","default":"#ffffff"},
    {"type":"color","id":"input_border_color","label":"Input border","default":"#8a776b"},
    {"type":"color","id":"button_color","label":"Button","default":"#000000"},
    {"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"},
    {"type":"color","id":"success_color","label":"Success text","default":"#245c42"},
    {"type":"color","id":"error_color","label":"Error text","default":"#9b2c2c"},
    {"type":"range","id":"heading_size","label":"Heading size","min":24,"max":56,"step":4,"unit":"px","default":40},
    {"type":"range","id":"input_radius","label":"Input radius","min":0,"max":20,"step":2,"unit":"px","default":0},
    {"type":"range","id":"button_radius","label":"Button radius","min":0,"max":20,"step":2,"unit":"px","default":0}
  ],
  "presets": [{"name":"Consultation form"}]
}
{% endschema %}
